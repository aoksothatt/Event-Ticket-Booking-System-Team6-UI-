# ─── Frontend (Vue 3 + Vite) environment template ───────────────────────────
# Copy this file to `.env` and adjust the values for your machine.
#   - Windows (cmd/PowerShell):  copy .env.example .env
#   - macOS / Linux / Git Bash:  cp .env.example .env
# After editing, restart the dev server (`npm run dev`).

# Root URL of the Laravel backend — no trailing slash.
VITE_BACKEND_URL=http://localhost:8001

# Axios base URL.
# Keep "/api" during development: the Vite dev proxy (vite.config.js)
# already forwards `/api` → Laravel, so no CORS is involved.
# Switch to an absolute URL (e.g. http://localhost:8000/api) only if the
# Laravel backend is configured to allow CORS from this frontend origin.
VITE_API_BASE=/api

# Full URL the browser is redirected to when a user clicks
# "Continue with Google". This is a Laravel *web* route (NOT under /api),
# so it must be an absolute URL that points directly at the backend.
VITE_GOOGLE_REDIRECT_URL=http://localhost:8001/auth/google

# Absolute URL of this Vue app (used as the origin for OAuth callbacks).
# In production this may be omitted: src/config/index.js then uses
# window.location.origin automatically.
VITE_APP_URL=http://localhost:5173

# ─── Production example (see .env.production) ───────────────────────────────
# VITE_BACKEND_URL=https://booking-8hbe.onrender.com
# VITE_API_BASE=https://booking-8hbe.onrender.com/api
# VITE_GOOGLE_REDIRECT_URL=https://booking-8hbe.onrender.com/auth/google
# VITE_APP_URL=https://your-frontend-domain
