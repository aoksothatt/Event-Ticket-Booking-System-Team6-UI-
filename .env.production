# Production values compiled into the Vite build.
# These are public browser values — never put server secrets in VITE_* vars.
VITE_BACKEND_URL=https://booking-8hbe.onrender.com
VITE_API_BASE=https://booking-8hbe.onrender.com/api
VITE_GOOGLE_REDIRECT_URL=https://booking-8hbe.onrender.com/auth/google

# Optional: set this to the deployed frontend origin (e.g. https://your-app.vercel.app).
# When omitted, src/config/index.js falls back to window.location.origin in production.
# VITE_APP_URL=https://your-frontend-domain
